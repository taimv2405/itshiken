# .env chỉ được đọc khi thư mục làm việc là BE/app
# IntelliJ: Run > Edit Configurations > ItshikenApplication > Modify options > Working directory, đặt thành <repo>/BE/app).

# Neon: dùng host direct (không có -pooler)
DB_URL=jdbc:postgresql://<host-direct>/itshiken_db?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me

# Chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=change-this-to-a-long-random-secret-key-32chars

GEMINI_API_KEY=change-me
LLM_PROVIDER=gemini

# Domain Vercel của FE, nhiều domain cách nhau bằng dấu phẩy (localhost:3000/3001 luôn được phép)
ALLOWED_ORIGINS=

# Chỉ bật khi chạy local, mở /api/ai/admin/**
INGEST_ENABLED=false
COOKIE_SECURE=false
